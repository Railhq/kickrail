KR_MONGODB_URI=mongodb://127.0.0.1:27017
KR_MONGODB_DB=kickrail
KR_PUBLIC_URL=http://localhost:3000
KR_APP_SECRET=
KR_INTERNAL_TOKEN=
KR_PLATFORM_STRIPE_SECRET_KEY=sk_test_...
KR_PLATFORM_STRIPE_WEBHOOK_SECRET=whsec_...
KR_PAYOUT_FEE_BPS=0
KR_PLATFORM_STRIPE_CONNECT_WEBHOOK_SECRET=

# Email: Brevo API key, or SMTP. Neither set = emails are only logged.
KR_BREVO_API_KEY=
KR_SMTP_HOST=
KR_MAIL_FROM=Kickrail <no-reply@kickrail.com>
# Set empty to drop " via Kickrail" from the From name.
KR_MAIL_VIA=" via Kickrail"
